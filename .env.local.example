# Copy this file to .env.local and fill in your own values.
# Every value here must come from YOUR OWN accounts (Upstash, Google Cloud, Vercel).
# Do not reuse credentials from any other deployment of this app.

# --- Upstash Redis (Storage > Create Database > Redis, in your Vercel dashboard,
# or directly at https://console.upstash.com) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Google Calendar sync (optional feature) ---
# 1. Create a Google Cloud project: https://console.cloud.google.com
# 2. Enable the "Google Calendar API"
# 3. Create a Service Account, then a JSON key for it
# 4. Share your target Google Calendar with the service account's email
#    (Settings > Share with specific people > give "Make changes to events")
# 5. Fill in the values below from the downloaded JSON key
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Optional: a public webcal:// URL for the calendar, shown in the app
VITE_CALENDAR_WEBCAL_URL=
